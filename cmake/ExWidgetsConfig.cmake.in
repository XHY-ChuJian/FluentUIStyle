@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Qt@QT_VERSION_MAJOR@ REQUIRED COMPONENTS Core Gui Widgets)

if(@EXWIDGETS_BUILD_FRAMELESS@)
    find_dependency(QWindowKit CONFIG REQUIRED)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/ExWidgetsTargets.cmake")

set(ExWidgets_ExWidgets_FOUND TRUE)
if(TARGET ExWidgets::Frameless)
    set(ExWidgets_Frameless_FOUND TRUE)
endif()

check_required_components(ExWidgets)
